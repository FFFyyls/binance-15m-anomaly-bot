# Create separate Binance Futures testnet credentials and paste them locally.
# Never commit a populated .env file.
BINANCE_API_KEY=replace_with_testnet_api_key
BINANCE_API_SECRET=replace_with_testnet_api_secret

# Safe defaults: simulated execution against Binance Futures testnet endpoints.
DRY_RUN=1
USE_TESTNET=1
# Required in addition to DRY_RUN=0 and USE_TESTNET=0 for production orders.
CONFIRM_LIVE_TRADING=

# Optional runtime controls.
SKIP_STARTUP_NET_CHECK=0
BINANCE_WS_BASE=
BACKTEST_BAR_CACHE_SIZE=8
